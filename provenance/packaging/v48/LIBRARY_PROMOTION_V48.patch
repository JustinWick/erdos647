+-- Accepted exact interfaces: endpoint_log_bounds
+example : (∀ t : ℝ, 0 ≤ t → t ≤ 1 / 2 → -Real.log (1 - t) ≤ t + t ^ 2) := Erdos647Sieve.Elementary.neg_log_one_sub_le_add_sq
+#check Erdos647Sieve.Elementary.neg_log_one_sub_le_add_sq

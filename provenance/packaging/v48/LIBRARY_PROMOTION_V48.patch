+-- Accepted exact interfaces: small_prime_debit_estimate
+example : (∀ H p : ℕ, 0 < p → (H : ℝ) / (p : ℝ) - 1 ≤ ((H / p : ℕ) : ℝ)) := Erdos647Sieve.Elementary.nat_quotient_cast_lower
+#check Erdos647Sieve.Elementary.nat_quotient_cast_lower

+        _ ≤ _ := by gcongr
+      calc
+      _ ≤ (θ N + N) * log x ^ 2 / x := by gcongr
+      _ ≤ (θ N + N) * (x ^ (1 / 2 : ℝ) / (1 / 2)) ^ 2 / x := by
+        gcongr

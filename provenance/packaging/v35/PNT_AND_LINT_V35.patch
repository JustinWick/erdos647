+/-- A nonnegative constant controls the theta error for every real x ≥ 2. -/
+theorem pnt : ∃ C ≥ 0, ∀ x ≥ 2, |θ x - x| ≤ C * x / log x ^ 2 := by
+  obtain ⟨c, hc⟩ := isBigO_iff'.1 pntBigO

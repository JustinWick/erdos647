+        elif first == 'Erdos647Research' and gate['package'] == 'research':
+            owner = root / 'research'
+        elif first == 'PrimeNumberTheoremAnd' and gate['package'] == 'research':
+            owner = root / 'research/.lake/packages/PrimeNumberTheoremAnd'
+        else:
